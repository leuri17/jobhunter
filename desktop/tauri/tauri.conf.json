{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobHunter",
  "version": "0.1.0",
  "identifier": "com.leuri17.jobhunter",
  "build": {
    "beforeDevCommand": "pnpm --filter @jobhunter/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @jobhunter/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JobHunter",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Local-first LinkedIn job discovery",
    "longDescription": "JobHunter discovers public LinkedIn job listings, scores them against your profile using OpenAI, and persists everything locally."
  }
}
