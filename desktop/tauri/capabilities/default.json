{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "core:event:allow-listen",
      "allow": [
        {
          "event": "sidecar://*"
        }
      ]
    },
    "dialog:allow-open",
    "allow-sidecar-port",
    "allow-notify-pipeline-complete"
  ]
}
