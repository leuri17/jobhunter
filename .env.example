# JobHunter environment variables
#
# Copy this file to `.env` and fill in the values that apply to your
# environment. Variables marked build-time are read at frontend build
# (Vite); variables marked runtime are read by the sidecar at process
# start. Test-only variables are checked by their respective suites.

# ── OpenAI (runtime) ──────────────────────────────────────────────
# Required. The sidecar calls OpenAI for profile extraction and job
# scoring. The key is read from process.env at sidecar boot.
OPENAI_API_KEY=

# Optional. Default: gpt-5. The model used for both profile extraction
# and job scoring. Used by the sidecar at process start.
OPENAI_MODEL=gpt-5

# ── Logging (runtime) ─────────────────────────────────────────────
# Optional. Default: info. One of trace|debug|info|warn|error|fatal|silent.
# The sidecar reads this from process.env at boot. config.logging.level
# in the operational config file overrides this when set.
LOG_LEVEL=info

# ── Sidecar (runtime) ─────────────────────────────────────────────
# Optional. Default: 0 (OS-assigned). The port the sidecar binds to.
# The Tauri shell supervisor reads the sidecar's `READY <port>` line on
# stdout and stores the discovered port in Tauri state, so this is only
# set explicitly for non-Tauri / non-supervised runs.
JOBHUNTER_SIDECAR_PORT=0

# ── Sidecar (dev-only) ────────────────────────────────────────────
# Optional. Default: unset (`cargo tauri dev` supervises the sidecar).
# Set to 1 to enable HMR-friendly split dev: run
# `pnpm --filter @jobhunter/sidecar dev` in one terminal and
# `JOBHUNTER_SIDECAR_EXTERNAL=1 cargo tauri dev` in another. Tauri
# reads the bound port from `desktop/sidecar/.sidecar-port` instead of
# spawning its own sidecar. See docs/development/desktop-dev.md.
# Production builds ignore this variable.
# JOBHUNTER_SIDECAR_EXTERNAL=1

# ── Test gating ───────────────────────────────────────────────────
# Optional. Default: unset (live tests skip). Set to 1 to enable the
# real-Chromium LinkedIn live tests in tests/live/linkedin.test.ts.
# Requires `pnpm exec playwright install chromium` and unblocked
# LinkedIn access.
LINKEDIN_LIVE=

# Optional. Default: unset (smoke tests skip). Set to 1 to enable the
# two *.smoke.test.ts files in tests/live/linkedin/. Same prerequisites
# as LINKEDIN_LIVE.
PLAYWRIGHT_SMOKE=

# Optional. Default: unset. Auto-set by GitHub Actions. The Playwright
# webServer config uses CI to decide whether to reuse an existing
# `pnpm dev` server (local) or boot a fresh one (CI).
CI=
