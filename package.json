{
  "name": "jobhunter",
  "version": "0.1.0",
  "description": "Local-first desktop app that scrapes public LinkedIn job search results, persists them locally, and ranks them with deterministic filters plus OpenAI scoring.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:acceptance": "vitest run --config vitest.config.ts tests/acceptance",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:list": "vitest list --config vitest.live.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "openai": "7.27.0",
    "pdf-parse": "2.4.5",
    "pino": "10.4.0",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "linkedom": "0.18.13",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
